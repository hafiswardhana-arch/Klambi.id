# ==============================================================================
# Klambi.id - Environment Variables Template
# Copy this file to .env.local for local development.
# NEVER commit .env or .env.local containing real secrets to Git.
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:4028

# Authentication & Session Security (OWASP Standard)
# Generate via: openssl rand -base64 32
JWT_SECRET=replace_with_high_entropy_secret_min_32_chars_in_production
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=604800

# Cryptography & At-Rest Data Encryption (AES-256-GCM)
# Generate via: openssl rand -base64 32
DATA_ENCRYPTION_KEY=replace_with_aes_256_master_key_32_bytes_in_production

# PCI-DSS Payment Gateway Integration (Midtrans / Xendit)
# Obtain from Midtrans Dashboard (Production or Sandbox)
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR-SANDBOX-SERVER-KEY
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-YOUR-SANDBOX-CLIENT-KEY
MIDTRANS_IS_PRODUCTION=false

# Xendit Integration (Alternative Gateway)
XENDIT_SECRET_KEY=xnd_development_YOUR_SECRET_KEY

# Logistics & S2S Webhook Verification
LOGISTICS_HMAC_SECRET=replace_with_logistics_hmac_secret

# Security & CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=https://klambi.id,https://www.klambi.id,http://localhost:4028,http://localhost:3000
